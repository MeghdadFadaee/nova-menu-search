{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "meghdadfadaee/nova-menu-search",
    "description": "Search and navigate Laravel Nova main menu items from the sidebar.",
    "type": "library",
    "keywords": [
        "laravel",
        "menu",
        "navigation",
        "nova",
        "nova-package",
        "search"
    ],
    "homepage": "https://github.com/MeghdadFadaee/nova-menu-search",
    "license": "MIT",
    "authors": [
        {
            "name": "Meghdad Fadaee"
        }
    ],
    "support": {
        "issues": "https://github.com/MeghdadFadaee/nova-menu-search/issues",
        "source": "https://github.com/MeghdadFadaee/nova-menu-search"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.48|^11.44|^12.1|^13.0",
        "laravel/nova": "^5.8"
    },
    "require-dev": {
        "laravel/nova-devtool": "^1.9",
        "laravel/pint": "^1.20",
        "orchestra/testbench-core": "^8.35|^9.12|^10.1|^11.0",
        "pestphp/pest": "^2.36|^3.8|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.0|^4.0|^5.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "MeghdadFadaee\\NovaMenuSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MeghdadFadaee\\NovaMenuSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "MeghdadFadaee\\NovaMenuSearch\\MenuSearchServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "pint",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
